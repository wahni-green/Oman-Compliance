{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-before-push.sh",
            "if": "Bash(git push*)",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
